{
  "name": "@agilehead/persona",
  "version": "0.0.1",
  "description": "OAuth authentication and identity management service",
  "type": "module",
  "private": true,
  "workspaces": [
    "services/*",
    "services/*/apps/*",
    "services/*/node/packages/*"
  ],
  "scripts": {
    "build": "npm run verify:structure && ./scripts/build.sh --no-format && node services/persona/csharp/scripts/generate-model.mjs --check && dotnet build Persona.CSharp.slnx --disable-build-servers -m:1 -p:UseSharedCompilation=false",
    "clean": "./scripts/clean.sh",
    "start": "./services/persona/scripts/start.sh",
    "test": "node services/persona/scripts/test-services.mjs",
    "migrate:persona:latest": "knex migrate:latest --knexfile services/persona/knexfile.persona.mjs",
    "migrate:persona:rollback": "knex migrate:rollback --knexfile services/persona/knexfile.persona.mjs",
    "migrate:persona:status": "knex migrate:status --knexfile services/persona/knexfile.persona.mjs",
    "migrate:persona:make": "knex migrate:make --knexfile services/persona/knexfile.persona.mjs",
    "build:native": "node services/persona/csharp/scripts/publish-native.mjs",
    "lint": "./scripts/lint-all.sh && ./node_modules/.bin/eslint \"services/persona/**/*.mjs\"",
    "test:contracts": "node services/persona/scripts/test-services.mjs",
    "format": "./scripts/format-all.sh",
    "generate:model": "node services/persona/csharp/scripts/generate-model.mjs",
    "test:integration": "./services/persona/scripts/test-integration.sh compose",
    "start:nativeaot": "./services/persona/scripts/start.sh nativeaot",
    "verify:structure": "node scripts/verify-structure.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/chai": "^5.2.3",
    "@types/node": "^26.0.0",
    "chai": "^6.0.0",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "prettier": "^3.4.2",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.19.1"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.0.0",
    "knex": "^3.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agilehead/persona.git"
  },
  "keywords": [
    "oauth",
    "authentication",
    "identity",
    "oidc",
    "typescript"
  ],
  "author": "Agilehead",
  "license": "MIT",
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.1": true
  }
}
